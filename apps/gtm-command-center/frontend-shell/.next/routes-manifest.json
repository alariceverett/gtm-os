{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/actions",
      "regex": "^/actions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/actions(?:/)?$"
    },
    {
      "page": "/comms",
      "regex": "^/comms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comms(?:/)?$"
    },
    {
      "page": "/ops",
      "regex": "^/ops(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ops(?:/)?$"
    },
    {
      "page": "/pilot",
      "regex": "^/pilot(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pilot(?:/)?$"
    },
    {
      "page": "/polish-demo",
      "regex": "^/polish\\-demo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/polish\\-demo(?:/)?$"
    },
    {
      "page": "/relationships",
      "regex": "^/relationships(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/relationships(?:/)?$"
    },
    {
      "page": "/research",
      "regex": "^/research(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/research(?:/)?$"
    },
    {
      "page": "/strategy",
      "regex": "^/strategy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/strategy(?:/)?$"
    },
    {
      "page": "/targeting",
      "regex": "^/targeting(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/targeting(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}