#!/bin/sh
#
# Pre-commit hook for AdZeta
# Validates DB migrations before allowing commits
#
# This hook ensures that:
# 1. All staged migration files have corresponding tests
# 2. Code quality checks pass via lint-staged
# 3. Supabase lint runs if available (placeholder for future)
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Get the list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Migration directory patterns (in order of priority)
MIGRATION_PATTERNS="migrations/
supabase/migrations/
db/migrations/
apps/*/migrations/
apps/*/supabase/migrations/"

# Check if any migration files are staged across all patterns
STAGED_MIGRATIONS=""
for pattern in $MIGRATION_PATTERNS; do
    # Convert glob pattern to actual matches
    matches=$(echo "$STAGED_FILES" | grep -E "^${pattern}.*\.sql$" || true)
    if [ -n "$matches" ]; then
        if [ -z "$STAGED_MIGRATIONS" ]; then
            STAGED_MIGRATIONS="$matches"
        else
            STAGED_MIGRATIONS="$STAGED_MIGRATIONS
$matches"
        fi
    fi
done

# Remove duplicates if any
STAGED_MIGRATIONS=$(echo "$STAGED_MIGRATIONS" | sort -u || true)

if [ -z "$STAGED_MIGRATIONS" ]; then
    echo "${GREEN}✓ No migration files staged${NC}"
    MIGRATIONS_PRESENT=false
else
    MIGRATIONS_PRESENT=true
    echo "${YELLOW}⚠ Migration files detected:${NC}"
    echo "$STAGED_MIGRATIONS" | while read -r file; do
        if [ -n "$file" ]; then
            echo "  - $file"
        fi
    done
fi

# Validation: Check for corresponding test files for each migration
if [ "$MIGRATIONS_PRESENT" = true ]; then
    echo ""
    echo "${BLUE}🔍 Validating migration tests...${NC}"
    
    MISSING_TESTS=0
    
    echo "$STAGED_MIGRATIONS" | while read -r migration_file; do
        # Skip empty lines
        [ -z "$migration_file" ] && continue
        
        # Extract the migration name (basename without extension)
        migration_name=$(basename "$migration_file" .sql)
        migration_dir=$(dirname "$migration_file")
        
        # Check multiple possible test locations
        # Priority order for test file locations
        TEST_LOCATIONS="
tests/migrations/${migration_name}.test.ts
tests/migrations/${migration_name}.spec.ts
tests/${migration_dir}/${migration_name}.test.ts
tests/${migration_dir}/${migration_name}.spec.ts
${migration_dir}/__tests__/${migration_name}.test.ts
${migration_dir}/__tests__/${migration_name}.spec.ts
"
        
        TEST_FOUND=false
        for test_file in $TEST_LOCATIONS; do
            if [ -f "$test_file" ]; then
                TEST_FOUND=true
                echo "${GREEN}✓ Test exists: $test_file${NC}"
                break
            fi
        done
        
        if [ "$TEST_FOUND" = false ]; then
            echo "${RED}✗ Missing test for: $migration_file${NC}"
            echo "${YELLOW}  Expected one of:${NC}"
            echo "$TEST_LOCATIONS" | while read -r loc; do
                [ -n "$loc" ] && echo "    - $loc"
            done
            MISSING_TESTS=$((MISSING_TESTS + 1))
            # Export for outer scope (bash limitation workaround)
            echo "MISSING_TESTS=$MISSING_TESTS" > /tmp/migration_test_status
        fi
    done
    
    # Check if any tests were missing
    if [ -f /tmp/migration_test_status ]; then
        MISSING_TESTS=$(grep -o 'MISSING_TESTS=[0-9]*' /tmp/migration_test_status | cut -d= -f2 || echo "0")
        rm -f /tmp/migration_test_status
    fi
    
    if [ "$MISSING_TESTS" -gt 0 ] 2>/dev/null && [ "$MISSING_TESTS" != "" ]; then
        echo ""
        echo "${RED}❌ COMMIT BLOCKED${NC}"
        echo "${RED}$MISSING_TESTS migration(s) missing test files.${NC}"
        echo ""
        echo "${YELLOW}Required: Create test file for each migration${NC}"
        echo ""
        echo "Test template available at: tests/migrations/migration.test.template.ts"
        echo ""
        echo "Quick start:"
        echo "  cp tests/migrations/migration.test.template.ts tests/migrations/<your_migration_name>.test.ts"
        echo ""
        exit 1
    fi
    
    echo "${GREEN}✓ All migrations have corresponding tests${NC}"
fi

# Run lint-staged if available
if command -v npx >/dev/null 2>&1; then
    # Check for lint-staged config in various forms
    HAS_LINTSTAGED=false
    
    if [ -f "lint-staged.config.js" ] || [ -f "lint-staged.config.mjs" ] || [ -f "lint-staged.config.cjs" ]; then
        HAS_LINTSTAGED=true
    elif [ -f ".lintstagedrc" ] || [ -f ".lintstagedrc.json" ] || [ -f ".lintstagedrc.yml" ] || [ -f ".lintstagedrc.yaml" ]; then
        HAS_LINTSTAGED=true
    elif [ -f ".lintstagedrc.js" ] || [ -f ".lintstagedrc.mjs" ] || [ -f ".lintstagedrc.cjs" ]; then
        HAS_LINTSTAGED=true
    elif grep -q '"lint-staged"' package.json 2>/dev/null; then
        HAS_LINTSTAGED=true
    fi
    
    if [ "$HAS_LINTSTAGED" = true ]; then
        echo ""
        echo "🧹 Running lint-staged..."
        npx lint-staged
    fi
fi

# Optional: Supabase lint (commented out - enable when supabase CLI is available)
# if command -v supabase >/dev/null 2>&1; then
#     echo ""
#     echo "🔍 Running Supabase lint..."
#     if ! supabase db lint; then
#         echo "${RED}❌ Supabase lint failed${NC}"
#         exit 1
#     fi
# fi

echo ""
echo "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
